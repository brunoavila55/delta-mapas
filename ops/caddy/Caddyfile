{
	admin off
}

{$APP_DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	reverse_proxy backend:8000 {
		header_up X-Delta-Client-IP {remote_host}
	}

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self';"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
	}
}
