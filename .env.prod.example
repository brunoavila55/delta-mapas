# Copie para .env.prod, restrinja as permissões e nunca versione o arquivo real.
# APP_DOMAIN deve ser somente o hostname público, sem https://, porta ou caminho.
APP_DOMAIN=mapas.example.com
APP_VERSION=local

DJANGO_SECRET_KEY=replace-with-at-least-50-cryptographically-random-characters
LOGIN_IP_THROTTLE_RATE=20/min
LOGIN_ACCOUNT_THROTTLE_RATE=5/min
POSTGRES_DB=delta_maps
POSTGRES_USER=delta_maps
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

MINIO_ACCESS_KEY=replace-with-a-random-minio-access-key
MINIO_SECRET_KEY=replace-with-a-long-random-minio-secret-key
MINIO_BUCKET=delta-mapas

COPERNICUS_CLIENT_ID=replace-with-your-copernicus-oauth-client-id
COPERNICUS_CLIENT_SECRET=replace-with-your-copernicus-oauth-client-secret
COPERNICUS_AUTH_MAX_RESPONSE_BYTES=65536
COPERNICUS_STAC_MAX_RESPONSE_BYTES=2097152
COPERNICUS_STAC_MAX_TOTAL_BYTES=8388608
GEOMETRY_MAX_COORDINATES=100000
GEOMETRY_MAX_COMPONENTS=1000
GEOMETRY_MAX_NESTING_DEPTH=8

TENANT_SCHEMA=principal
TENANT_NAME=Delta Mapas
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=replace-with-a-long-random-admin-password
INITIAL_CREDITS=10
NDVI_CREDIT_COST=1

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
CELERY_WORKER_CONCURRENCY=1
MAP_JOB_STALE_MINUTES=120
MAP_RECONCILIATION_ENABLED=true
MAP_RECONCILIATION_INTERVAL_SECONDS=900
MAP_RECONCILIATION_APPLY_STALLED=true
MAP_RECONCILIATION_DELETE_ORPHANS=false

# Opcional: sem URL, alertas continuam disponíveis nos logs JSON.
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_WEBHOOK_SECRET=
OPERATIONS_ALERT_TIMEOUT_SECONDS=10
OPERATIONS_ALERT_COOLDOWN_SECONDS=21600

# Deve estar em disco separado ou ser sincronizado para storage externo criptografado.
BACKUP_DIRECTORY=/var/backups/delta-mapas
BACKUP_SIGNING_KEY=replace-with-a-different-random-backup-signing-key
BACKUP_ENVIRONMENT=production
BACKUP_RETENTION_DAYS=14

# Ative preload apenas depois de confirmar que todos os subdomínios usam HTTPS.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
