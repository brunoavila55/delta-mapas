# OAuth client do Sentinel Hub no Copernicus Data Space.
# Não são usuário/senha nem chaves S3. Não versionar os valores reais.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Desenvolvimento local. Gere senhas hexadecimais independentes antes de iniciar.
POSTGRES_ADMIN_PASSWORD=
DELTA_DB_PASSWORD=
DATABASE_URL=postgres://delta_app:SENHA_HEXADECIMAL@127.0.0.1:5439/delta_maps
APP_ORIGIN=http://127.0.0.1:3010
APP_BIND=127.0.0.1:3010
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
DEMO_ENABLED=true
STORAGE_DIRECTORY=output/private
