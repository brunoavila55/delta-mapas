FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        binutils \
        curl \
        gdal-bin \
        libgdal-dev \
        libgeos-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements ./requirements
RUN pip install --upgrade pip \
    && pip install -r requirements/base.txt

RUN groupadd --system app && useradd --system --gid app app

COPY --chown=app:app . .

RUN DJANGO_SECRET_KEY=build-only-secret-not-used-at-runtime \
    DJANGO_DEBUG=false \
    python manage.py collectstatic --noinput

USER app

EXPOSE 8000

CMD ["sh", "-c", "exec gunicorn delta_maps.wsgi:application --bind 0.0.0.0:8000 --workers ${GUNICORN_WORKERS:-3} --threads ${GUNICORN_THREADS:-2} --timeout ${GUNICORN_TIMEOUT:-120} --access-logfile - --error-logfile -"]
